# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-u-iap-2026

# Database Configuration
# Default is SQLite for local development
DATABASE_URL=sqlite:///u_iap.db
# For TiDB Cloud Starter / MySQL Staging & Production:
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?ssl_ca=/path/to/ca.pem

# Storage Configuration (local | s3)
STORAGE_PROVIDER=local
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760  # 10MB

# U-IAP Operational Workflow Configuration
# OQ-04: If True, logging is disabled until Liaison reviews and approves Acceptance Form.
# If False, logging can proceed immediately while review occurs asynchronously.
REQUIRE_ACCEPTANCE_APPROVAL_BEFORE_LOGGING=false

# Signatory details for official Introductory Letters
LIAISON_HEAD_NAME=Dr. Kwame Asante
LIAISON_HEAD_TITLE=Head, Industrial Liaison Unit
UNIVERSITY_NAME=University of Skills Training and Entrepreneurial Development (USTED)
